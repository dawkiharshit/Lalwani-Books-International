# ─────────────────────────────────────────────────────────────────────────────
# Lalwani Books International API — production environment template
#
# This is a TEMPLATE. It is not loaded by Laravel and holds no real values.
# On the server, the live file is `.env`, and an update zip never contains it,
# so uploading an update cannot overwrite your settings.
#
# Only use this when setting up a NEW server, or to check the live .env has
# every key it needs. Fill each CHANGE_ME; leave the rest as they are.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Lalwani Books International"
APP_ENV=production
APP_DEBUG=false

# NEVER regenerate this on a server that already has one.
#
# The Razorpay, Shiprocket and Google secrets saved in admin → Integrations are
# encrypted with this key. A new key makes every one of them unreadable — they
# are silently treated as unset, and online payment, couriers and Google
# sign-in all stop working until each is re-entered by hand.
#
# Fresh server only: leave blank, then run  php artisan key:generate
APP_KEY=

APP_URL=https://api.lalwanibooks.com

# The public storefront. This is the CORS origin: if it is wrong, the browser
# blocks every client-side call — cart, login, search, checkout — while pages
# still render, so the site looks half-working rather than broken. It is also
# where Google sign-in returns to, and what order emails link back to.
# The www./bare twin is allowed automatically (config/cors.php), so this works
# whether visitors type www.lalwanibooks.com or lalwanibooks.com.
FRONTEND_URL=https://lalwanibooks.com

# The admin panel's own address. CORS allows it next to the storefront;
# leave it out and every save in the admin panel is blocked.
ADMIN_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# error, not debug: a debug log on a busy shop fills the disk with noise.
LOG_LEVEL=error

# hPanel → Databases. Hostinger names look like  u123456789_lalwanibooks
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Admin → Integrations → Email overrides these at runtime, which is the place
# to set them. With MAIL_MAILER=log and nothing in admin, mail is written to
# storage/logs instead of sent — no order confirmations, no password resets.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=CHANGE_ME
MAIL_FROM_NAME="${APP_NAME}"

# Gateway keys are normally entered in admin → Integrations, which stores them
# encrypted and wins over these. Leave blank unless you deliberately want them
# pinned in the environment instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Must match a pickup nickname registered in your Shiprocket account exactly.
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_CHANNEL_ID=
# Optional. Shiprocket's API address; the default is correct.
# SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# Seeded admin account — only read by `db:seed`, never at runtime.
ADMIN_NAME="Lalwani Books Admin"
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# Shared with the storefront's environment so the API can tell Next.js to
# rebuild a cached page after an admin edit. Must be identical on both hosts.
REVALIDATE_SECRET=CHANGE_ME
