# ─────────────────────────────────────────────────────────────────────────────
# Lalwani Books International storefront — production environment template
#
# A TEMPLATE, not loaded by Next.js. On Hostinger, set these in the Node app's
# Environment Variables panel, not in a file — the panel survives redeploys.
#
# Requires Node.js 20.9 or newer (Next.js 16.3). Older Node fails the build.
# ─────────────────────────────────────────────────────────────────────────────

# The API, including /api/v1.
#
# Read at BUILD time, not run time: it is compiled into the JavaScript the
# browser downloads. Changing it does nothing until you redeploy.
NEXT_PUBLIC_API_URL=https://lalwanibooks.laxmipaperproducts.in/api/v1

# This storefront's own public address, with no trailing slash.
#
# Unset, it falls back to http://localhost — so sitemap.xml lists localhost
# URLs, robots.txt points crawlers at a localhost sitemap, and every social
# share preview links to localhost. Nothing visibly breaks, which is why it
# goes unnoticed; search engines just index nothing useful.
NEXT_PUBLIC_SITE_URL=https://app.lalwanibooks.com

# Server-only — no NEXT_PUBLIC_ prefix, so it never reaches the browser.
# Lets the API ask Next.js to rebuild a cached page after an admin edit.
# Must be identical to REVALIDATE_SECRET in the API's .env.
REVALIDATE_SECRET=CHANGE_ME

# Hide the shop from Google, Bing and the rest: "false" makes robots.txt say
# "do not read anything". Keep it while the old store still answers on
# lalwanibooks.com — the two sites sell the same books, and Google counting
# this address as a second copy would cost the old store its places in search.
# Read at run time, so a change here takes effect on the next restart.
# Delete this line on the day this shop takes over the main address.
ALLOW_SEARCH_ENGINES=false
